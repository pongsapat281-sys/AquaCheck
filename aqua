 `<div class="card wrap"><table><tr><th>พารามิเตอร์</th><th>ค่าเกณฑ์</th><th>เฉลี่ย</th><th>ต่ำสุด</th><th>สูงสุด</th><th>ตัวอย่าง</th><th>เกินเกณฑ์</th><th style="width:140px">สัดส่วน</th><th>สถานะ</th></tr>${items.map(({k,s})=>`<tr><td><b>${k}</b> <span class="mut">${P[k].n}</span></td><td>${limTxt(k)} ${lim(k)?P[k].u:""}</td><td>${fmt(s.mean,2)}</td><td>${fmt(s.min,2)}</td><td>${fmt(s.max,2)}</td><td>${s.n.toLocaleString()}</td><td>${lim(k)?s.ex.toLocaleString():"–"}</td><td><div class="bar"><i style="width:${Math.min(100,s.pct)}%;background:${s.pct>=5?"var(--bad)":"var(--warn)"}"></i></div></td><td>${pill(k,s)}</td></tr>`).join("")}</table></div>`+
 (st.sites.length>1?`<div class="card wrap" style="margin-top:16px"><b>ค่าเฉลี่ยแยกตามจุดเก็บ</b> <span class="mut">สีแดงคือเกินเกณฑ์</span><table style="margin-top:8px"><tr><th>จุดเก็บ</th>${st.avail.map(k=>`<th>${k}</th>`).join("")}</tr>${st.sites.map(si=>{const rs=rows.filter(o=>o.site==si);return `<tr><td>${esc(si)}</td>${st.avail.map(k=>{const t=stats(k,rs);return `<td style="${t&&evalP(k,t.mean)===false?"color:var(--bad);font-weight:600":""}">${t?fmt(t.mean,2):"–"}</td>`}).join("")}</tr>`}).join("")}</table></div>`:"")+
 '<div class="foot"><button class="ghost" id="pr">พิมพ์ / บันทึกเป็น PDF</button><button class="ghost" id="cs">ดาวน์โหลดสรุป (CSV)</button></div>';
 bindBar("compliance");$("#pr").onclick=()=>window.print();
 $("#cs").onclick=()=>save("compliance-summary.csv","พารามิเตอร์,ค่าเกณฑ์,เฉลี่ย,ต่ำสุด,สูงสุด,ตัวอย่าง,เกินเกณฑ์,สัดส่วนเกิน(%)\n"+items.map(({k,s})=>[k,csvq(limTxt(k)),fmt(s.mean,2),fmt(s.min,2),fmt(s.max,2),s.n,s.ex,fmt(s.pct,1)].join(",")).join("\n"));
};
const ready=r=>r=="upload"||(r=="map"?!!st.tbl:r=="clean"?!!st.rows:!!(st.rows&&st.rows.length));
function go(r){if(location.hash.slice(1)==r)render();else location.hash=r}
function render(){
 let r=location.hash.slice(1);if(!V[r])r="upload";
 if(!ready(r))r=st.tbl?"map":"upload";
 document.querySelectorAll("aside a").forEach(a=>{a.classList.toggle("on",a.dataset.r==r);a.classList.toggle("dis",!ready(a.dataset.r))});
 try{V[r]();window.scrollTo(0,0)}catch(e){app.innerHTML='<div class="alert"><b>แสดงหน้านี้ไม่สำเร็จ</b><div>'+esc(e.message)+'</div><div class="foot"><button id="rs">กลับไปหน้านำเข้าไฟล์</button></div></div>';$("#rs").onclick=()=>go("upload")}
}
window.addEventListener("hashchange",render);
$("#theme").onclick=()=>{const d=document.documentElement,dark=getComputedStyle(d).getPropertyValue("--bg").trim()=="#0d1a21";d.setAttribute("data-theme",dark?"light":"dark")};
render();
</script>
